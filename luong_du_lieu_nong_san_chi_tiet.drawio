        </mxCell>
        <mxCell id="tt-64" value="&lt;b&gt;Phạm vi (scope)&lt;/b&gt;&lt;br&gt;'all' hoặc danh sách sản phẩm (tham số products). Chỉ so snapshot &lt;b&gt;cùng scope&lt;/b&gt; – tải riêng 'Vải' không so với bản 'tất cả'. &amp;nbsp;&amp;nbsp; &lt;b&gt;Full reload&lt;/b&gt; (TRUNCATE rồi nạp toàn bộ) chỉ khi chưa có mốc / kho trống và scope = all.&lt;br&gt;&lt;b&gt;Chạy lại cùng ngày&lt;/b&gt;: mốc luôn là commit dt &amp;lt; D → cùng kết quả; fact dùng version nên ghi trùng không sao; cdc_log và price_clean xoá rồi ghi lại.&lt;br&gt;&lt;b&gt;Ví dụ test&lt;/b&gt; (bản cũ giả lập → bản thật 18/10): 159 new_month · 3 revision · 3 backfill · 1 removed&lt;br&gt; — đối soát: 7.337 khoá tháng · 40.575 dòng price_clean" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="1110" width="2620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tt-65" value="ClickHouse – database ttns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1950" y="345" width="670" height="735" as="geometry" />
        </mxCell>
        <mxCell id="tt-66" value="&lt;b&gt;fact_price_monthly&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ENGINE = ReplacingMergeTree(version, is_deleted)&lt;br&gt;load: INSERT fact_upsert.csv → bản có version lớn nhất thắng&lt;br&gt;đọc: … FINAL WHERE is_deleted = 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1970" y="395" width="630" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tt-67" value="&lt;b&gt;price_clean&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;load: DELETE WHERE (khoá) IN (SELECT … FROM s3(changed_keys.csv))&lt;br&gt;→ INSERT price_clean_upsert.csv&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
