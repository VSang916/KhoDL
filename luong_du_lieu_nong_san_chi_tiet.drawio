<mxfile host="Electron">
  <diagram id="ov" name="1. Tổng quan kiến trúc">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ov-1" value="&lt;b&gt;Luồng dữ liệu nông sản – tổng quan kiến trúc&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="0" y="-90" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ov-2" value="2 nguồn: Winmart API (giá siêu thị, hằng ngày) và thitruongnongsan.gov.vn (giá rau quả trong nước, toàn bộ lịch sử). Mỗi nguồn là 1 DAG Airflow: Extract → Data Lake → Làm sạch + CDC → Data Warehouse → BI." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="0" y="-52" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;fillColor=#ffffff;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="1080" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ov-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="312" y="12" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ov-5" value="&lt;b&gt;winmart_api_pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lịch: 0 7 * * * (7h hằng ngày)&lt;br&gt;ensure_buckets → extract → transform → &lt;b&gt;cdc&lt;/b&gt; → validate → load_clickhouse → &lt;b&gt;commit_cdc&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="18" width="420" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ov-6" value="&lt;b&gt;ttns_price_pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lịch: 0 6 * * 1 (6h thứ Hai)&lt;br&gt;extract → &lt;b&gt;check_changed&lt;/b&gt; → transform → prepare → &lt;b&gt;cdc&lt;/b&gt; → validate → load → &lt;b&gt;commit_cdc&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="955" y="18" width="415" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ov-7" value="Data sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="170" width="250" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ov-8" value="&lt;b&gt;Winmart API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;api-crownx.winmart.vn&lt;br&gt;JSON, phân trang&lt;br&gt;&lt;i&gt;chỉ trả TRẠNG THÁI HIỆN TẠI&lt;/i&gt;&lt;br&gt;(giá, khuyến mãi, tồn kho)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="15" y="220" width="220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ov-9" value="&lt;b&gt;thitruongnongsan.gov.vn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ASP.NET WebForms – không có API&lt;br&gt;mục 6: Giá rau quả trong nước&lt;br&gt;&lt;i&gt;mỗi lần xuất = TOÀN BỘ lịch sử&lt;/i&gt;&lt;br&gt;(2021 → nay, cập nhật theo tháng)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="15" y="370" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ov-10" value="&lt;b&gt;DB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(dự kiến)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="15" y="560" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ov-11" value="Data Ingestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="300" y="170" width="270" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ov-12" value="&lt;b&gt;API Connector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pipelines/winmart/api.py&lt;br&gt;requests + retry/backoff&lt;br&gt;lặp trang đến khi không còn item mới&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="315" y="220" width="240" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ov-13" value="&lt;b&gt;Web Scraper&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pipelines/ttns/scraper.py&lt;br&gt;requests + postback ASP.NET:&lt;br&gt;GET → click mục 6 → chọn 5 ô lọc&lt;br&gt;(mỗi ô 1 POST kèm __VIEWSTATE)&lt;br&gt;→ bấm &quot;Xuất excel&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
