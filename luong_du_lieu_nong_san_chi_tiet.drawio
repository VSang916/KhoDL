        <mxCell id="ov-17" value="&lt;b&gt;raw-data/  – file gốc, không chỉnh sửa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;winmart_api/dt=D/store=1535/&amp;lt;slug&amp;gt;.json&lt;br&gt;ttns/dt=D/cat102_item6_all.xlsx&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
