        <mxCell id="wm-52" value="giữ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="wm-32" target="wm-37">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="905" />
              <mxPoint x="1365" y="905" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="wm-53" value="ClickHouse – database winmart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1640" y="300" width="640" height="640" as="geometry" />
        </mxCell>
        <mxCell id="wm-54" value="&lt;b&gt;fact_price  – giá của từng ngày chạy (PARTITION BY date_id)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;load: ALTER TABLE … DROP PARTITION D  →  INSERT từ fact_price.csv&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1660" y="345" width="600" height="85" as="geometry" />
        </mxCell>
        <mxCell id="wm-55" value="&lt;b&gt;price_changes  – nhật ký thay đổi (CDC)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;load: DELETE WHERE change_date_id = D  →  INSERT price_changes.csv&lt;br&gt;luôn tính lại so với cùng 1 mốc → xoá rồi ghi lại là idempotent&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1660" y="445" width="600" height="105" as="geometry" />
        </mxCell>
        <mxCell id="wm-56" value="&lt;b&gt;v_price_history  – SCD loại 2 (view dựng từ price_changes)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;valid_from = ngày thay đổi&lt;br&gt;valid_to = leadInFrame(ngày thay đổi kế tiếp), NULL = đang áp dụng&lt;br&gt;is_current = valid_to IS NULL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1660" y="565" width="600" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-57" value="&lt;b&gt;dim_product · dim_market · dim_date  (ReplacingMergeTree)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;v_price_daily&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1660" y="705" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wm-58" value="&lt;b&gt;Ví dụ thật (replay 13/10 → 18/10):&lt;/b&gt;&lt;br&gt;15 new_item · 3 promo_end · 1 price_down · 1 price_up · 13 pending (chưa xoá)&lt;br&gt;&lt;br&gt;Táo Jazz NZ: 89.900đ (KM, 13/10 → 18/10) → 109.000đ (hiện tại)&lt;br&gt;Táo Breeze 1kg: 139.000đ → 99.900đ (price_down)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1660" y="790" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wm-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="wm-36" target="wm-55">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-60" value="view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-55" target="wm-56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-61" value="&lt;b&gt;Vì sao CDC kiểu snapshot?&lt;/b&gt;&lt;br&gt;API không có log thay đổi / cột updated_at → không dùng được Debezium. Lịch sử giá chỉ tồn tại trong kho: ngày nào không chạy là mất ngày đó (không backfill từ nguồn được), nên bảng price_changes &lt;b&gt;không tự xoá-tạo lại&lt;/b&gt; khi đổi schema." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="975" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="wm-62" value="&lt;b&gt;Idempotent &amp;amp; tự phục hồi&lt;/b&gt;&lt;br&gt;• Mốc = snapshot đã commit gần nhất có dt &amp;lt; D&lt;br&gt;• _meta.json chỉ ghi khi load OK → lần lỗi không làm hỏng mốc&lt;br&gt;• replay_dt = YYYY-MM-DD: chạy lại từ raw cũ trên MinIO" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="975" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="wm-63" value="&lt;b&gt;Tham số&lt;/b&gt; (pipelines/winmart/cdc.py)&lt;br&gt;KEYS = item_no, store_code&lt;br&gt;TRACKED = original_price, selling_price, promotion_code, is_promo&lt;br&gt;DELETE_AFTER_DAYS = 2 · MIN_COVERAGE = 0.8" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1540" y="975" width="740" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tt" name="3. TTNS – luồng &amp; CDC">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tt-1" value="&lt;b&gt;Luồng thitruongnongsan.gov.vn – CDC phát hiện dữ liệu mới &amp;amp; dữ liệu quá khứ bị sửa&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="0" y="-90" width="1900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tt-2" value="Mỗi lần xuất là TOÀN BỘ lịch sử, không có khoá, dòng trùng hợp lệ (nhiều lần báo giá/tháng), cộng tác viên có thể sửa số liệu tháng cũ → so ở mức tổng hợp tháng (có khoá rõ ràng) + theo nhóm cho price_clean." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="0" y="-52" width="2500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tt-3" value="Airflow DAG: ttns_price_pipeline  —  0 6 * * 1  (6h thứ Hai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;fillColor=#fff8ee;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tt-4" value="&lt;b&gt;ensure_buckets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-5" value="&lt;b&gt;extract&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-6" value="&lt;b&gt;check_changed&lt;/b&gt;&lt;br&gt;(short_circuit)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="32" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tt-7" value="&lt;b&gt;transform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="890" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-8" value="&lt;b&gt;prepare_clickhouse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1180" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-9" value="&lt;b&gt;cdc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1470" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-10" value="&lt;b&gt;validate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1760" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-11" value="&lt;b&gt;load_clickhouse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2050" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-12" value="&lt;b&gt;commit_cdc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2340" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tt-13" value="tạo bucket nếu chưa có" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="5" y="135" width="262" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tt-14" value="web (hoặc replay_dt) →&lt;br&gt;raw-data/ttns/dt=D/cat102_item6_all.xlsx&lt;br&gt;&lt;b&gt;content_md5&lt;/b&gt; = md5(read_excel → csv)&lt;br&gt;&lt;i&gt;không md5 file: web nén zip lại mỗi lần xuất nên byte luôn khác&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="295" y="135" width="262" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tt-15" value="làm sạch: NFC, gộp tên, đơn vị, cap_gia,&lt;br&gt;điền tỉnh mới, outlier&lt;br&gt;→ dim_*, price_clean, fact_price_monthly&lt;br&gt;→ processed-data/ttns/dt=D/*.csv" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="875" y="135" width="262" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tt-16" value="tạo / migrate bảng&lt;br&gt;(chỉ bảng REBUILDABLE được tạo lại)&lt;br&gt;kho trống → lần này &lt;b&gt;full reload&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1165" y="135" width="262" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tt-17" value="2 nhánh CDC → file thay đổi&lt;br&gt;+ snapshot mới&lt;br&gt;&lt;b&gt;(chi tiết bên dưới)&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1455" y="135" width="262" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tt-18" value="removed &amp;gt; 20% khoá so với mốc&lt;br&gt;→ &lt;b&gt;FAIL&lt;/b&gt; (nghi export lỗi / đổi tên)&lt;br&gt;trừ khi force = true" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1745" y="135" width="262" height="145" as="geometry" />
