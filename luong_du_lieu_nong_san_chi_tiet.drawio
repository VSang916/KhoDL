        <mxCell id="wm-51" value="giữ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="wm-35" target="wm-37">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1595" y="807" />
