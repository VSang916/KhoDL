  <diagram id="wm" name="2. Winmart – luồng &amp; CDC">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wm-1" value="&lt;b&gt;Luồng Winmart API – CDC trạng thái giá theo sản phẩm&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="0" y="-90" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wm-2" value="API chỉ trả trạng thái HIỆN TẠI → lịch sử giá chỉ tồn tại trong kho. CDC so trạng thái hôm nay với snapshot ngày trước để sinh ra nhật ký thay đổi (tăng/giảm giá, bắt đầu/kết thúc khuyến mãi, sản phẩm mới/ngừng bán)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="0" y="-52" width="2200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="wm-3" value="Airflow DAG: winmart_api_pipeline  —  0 7 * * *  (7h hằng ngày)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;fillColor=#fff8ee;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2280" height="255" as="geometry" />
        </mxCell>
        <mxCell id="wm-4" value="&lt;b&gt;ensure_buckets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-5" value="tạo bucket raw-data, processed-data nếu chưa có" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="5" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-6" value="&lt;b&gt;extract&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="342" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-7" value="gọi API từng (cửa hàng, danh mục)&lt;br&gt;→ raw-data/winmart_api/dt=D/store=…/&amp;lt;slug&amp;gt;.json&lt;br&gt;&lt;i&gt;replay_dt: đọc raw đã lưu, không gọi API&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="327" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-8" value="&lt;b&gt;transform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="664" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-9" value="JSON → dim_product, dim_market,&lt;br&gt;dim_date, fact_price&lt;br&gt;→ processed-data/winmart_api/dt=D/*.csv" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="649" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-10" value="&lt;b&gt;cdc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="986" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-11" value="so fact_price ngày D với snapshot mốc&lt;br&gt;→ price_changes.csv&lt;br&gt;→ _cdc/all/dt=D/snapshot.csv&lt;br&gt;&lt;b&gt;(chi tiết bên dưới)&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="971" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-12" value="&lt;b&gt;validate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1308" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-13" value="raw + 4 CSV tồn tại, không bảng rỗng,&lt;br&gt;có price_changes.csv" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1293" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-14" value="&lt;b&gt;load_clickhouse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1630" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-15" value="fact_price: DROP PARTITION D → INSERT&lt;br&gt;price_changes: DELETE ngày D → INSERT&lt;br&gt;đối soát số dòng" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1615" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-16" value="&lt;b&gt;commit_cdc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1952" y="45" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wm-17" value="ghi _cdc/all/dt=D/_meta.json&lt;br&gt;→ snapshot D thành mốc cho ngày sau&lt;br&gt;&lt;i&gt;(chỉ chạy khi load OK)&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1937" y="115" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-4" target="wm-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-6" target="wm-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-8" target="wm-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-10" target="wm-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-12" target="wm-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="wm-14" target="wm-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wm-24" value="Chi tiết task cdc  (pipelines/winmart/cdc.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=4;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="300" width="1600" height="640" as="geometry" />
        </mxCell>
        <mxCell id="wm-25" value="&lt;b&gt;Snapshot mốc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;_cdc/all/dt=&amp;lt;mốc&amp;gt;/snapshot.csv&lt;br&gt;mốc = dt đã commit gần nhất &amp;lt; D&lt;br&gt;cột: item_no, store_code, giá, KM,&lt;br&gt;row_hash, last_seen_date_id, missing_days&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wm-26" value="&lt;b&gt;Trạng thái hôm nay (D)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;processed/…/dt=D/fact_price.csv&lt;br&gt;row_hash = md5(original_price, selling_price,&lt;br&gt;promotion_code, is_promo)&lt;br&gt;&lt;i&gt;không hash stock_quantity (đổi liên tục)&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="wm-27" value="&lt;b&gt;diff_snapshots&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;outer join theo&lt;br&gt;(item_no, store_code)&lt;br&gt;so sánh row_hash&lt;br&gt;&lt;i&gt;hash giống → bỏ qua&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="425" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wm-28" value="&lt;b&gt;Chỉ có ở D  →  I&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;change_type = new_item&lt;br&gt;(= initial nếu chưa có mốc)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="335" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wm-29" value="&lt;b&gt;Có ở cả 2, hash khác  →  U&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;promo_start / promo_end  (is_promo đổi)&lt;br&gt;price_down / price_up  (selling_price đổi)&lt;br&gt;other  (đổi giá gốc / mã KM)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wm-30" value="&lt;b&gt;Chỉ có ở mốc  →  vắng mặt&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="560" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wm-31" value="Hôm nay lấy được ≥ 80%&lt;br&gt;số SP đang bán của mốc?&lt;br&gt;(MIN_COVERAGE)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="765" y="660" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wm-32" value="&lt;b&gt;Nghi API trả thiếu (partial_fetch)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;không đếm vắng mặt,&lt;br&gt;giữ nguyên trong snapshot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="680" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="wm-33" value="missing_days + 1&lt;br&gt;≥ 2 ?&lt;br&gt;(DELETE_AFTER_DAYS)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1100" y="660" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wm-34" value="&lt;b&gt;D: removed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;xoá khỏi snapshot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1390" y="600" width="190" height="80" as="geometry" />
        </mxCell>
