        <mxCell id="tt-53" value="&lt;b&gt;Nhánh B – price_clean&lt;/b&gt; (không có khoá từng dòng, dòng trùng hợp lệ → CDC theo NHÓM khoá)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#7a4d99;" vertex="1" parent="1">
