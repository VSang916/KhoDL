        <mxCell id="tt-56" value="&lt;b&gt;clean_groups + diff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hash từng dòng → sắp xếp →&lt;br&gt;hash cả NHÓM khoá&lt;br&gt;(không phụ thuộc thứ tự dòng)&lt;br&gt;→ nhóm I / U / D&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=8;spacingRight=6;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="830" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tt-57" value="&lt;b&gt;Vì sao tách khỏi nhánh A?&lt;/b&gt;&lt;br&gt;fact_price_monthly bỏ các nhóm chỉ toàn giá bất thường (không có giá tin cậy), còn price_clean vẫn giữ các dòng đó.&lt;br&gt;&lt;br&gt;Lấy khoá từ fact sẽ làm rơi dòng – lỗi thật đã gặp khi test: thiếu 113 dòng, bị bước đối soát chặn lại trước khi commit." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
